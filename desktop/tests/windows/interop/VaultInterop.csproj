<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <StartupObject>SC.VaultInteropFixture</StartupObject>
    <AssemblyName>SC.VaultInteropFixture</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LegacySource>$(MSBuildThisFileDirectory)legacy</LegacySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(LegacySource)/GlobalUsings.cs" Link="Legacy/GlobalUsings.cs" />
    <!-- Frozen v0.4.14 serializers, validators, DPAPI and migration implementation. -->
    <Compile Include="$(LegacySource)/Storage/ApiKeyVault.cs" Link="Legacy/ApiKeyVault.cs" />
    <Compile Include="$(LegacySource)/Storage/AppStorage.cs" Link="Legacy/AppStorage.cs" />
    <Compile Include="$(LegacySource)/Platform/HotkeyBinding.cs" Link="Legacy/HotkeyBinding.cs" />
    <Compile Include="$(LegacySource)/Platform/ShortcutSet.cs" Link="Legacy/ShortcutSet.cs" />
    <Compile Include="$(LegacySource)/Platform/NativeMethods.cs" Link="Legacy/NativeMethods.cs" />
    <Compile Include="$(LegacySource)/UI/UiAppearance.cs" Link="Legacy/UiAppearance.cs" />
    <Compile Include="$(LegacySource)/Providers/ModelSelection.cs" Link="Legacy/ModelSelection.cs" />
    <!-- Transitive types required by the legacy pipeline enum and its validators. -->
    <Compile Include="$(LegacySource)/Pipeline/PipelineConfiguration.cs" Link="Legacy/PipelineConfiguration.cs" />
    <Compile Include="$(LegacySource)/Pipeline/QuestionContent.cs" Link="Legacy/QuestionContent.cs" />
    <Compile Include="$(LegacySource)/Pipeline/PipelineTrace.cs" Link="Legacy/PipelineTrace.cs" />
    <Compile Include="$(LegacySource)/Providers/ModelUsage.cs" Link="Legacy/ModelUsage.cs" />
    <Compile Include="$(LegacySource)/Providers/OpenAiResponsesClient.cs" Link="Legacy/OpenAiResponsesClient.cs" />
    <Compile Include="$(LegacySource)/Providers/ApiNetwork.cs" Link="Legacy/ApiNetwork.cs" />
  </ItemGroup>
</Project>
