{
  "name": "sc-desktop",
  "version": "0.5.0-beta.7",
  "private": true,
  "description": "SC desktop companion",
  "homepage": "https://github.com/Ziyadin23/ScreenCompanion",
  "author": "Ziyadin23",
  "desktopName": "io.github.ziyadin23.sc.desktop",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview:ui": "electron-vite preview -- --synthetic-ui",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ui": "node scripts/ui-tests.mjs",
    "test:windows": "node scripts/windows-tests.mjs",
    "native:build": "node scripts/build-native.mjs",
    "package:win": "npm run typecheck && npm run native:build && npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:zip": "node scripts/package-zip.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "package:installer": "npm run typecheck && npm run native:build && npm run build && electron-builder --win nsis --x64 --publish never",
    "package:rpm": "npm run typecheck && npm run build && electron-builder --linux rpm --x64 --publish never",
    "test:lab": "node scripts/lab-tests.mjs",
    "test:deepseek": "node scripts/deepseek-tests.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "SC.Desktop",
    "productName": "SC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "native/build/Release/sc_windows.node",
          "to": "native/sc_windows.node"
        }
      ],
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "SC-v${version}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "rpm"
      ],
      "category": "Utility",
      "executableName": "io.github.ziyadin23.sc",
      "syncDesktopName": true,
      "artifactName": "SC-v${version}-${arch}.${ext}"
    },
    "rpm": {
      "maintainer": "Ziyadin23",
      "afterInstall": "scripts/rpm-after-install.sh",
      "afterRemove": "scripts/rpm-after-remove.sh",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "gnome-keyring",
        "curl",
        "pipewire",
        "xdg-desktop-portal",
        "xdg-desktop-portal-hyprland"
      ]
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "SC-Setup-v${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Ziyadin23",
      "repo": "ScreenCompanion",
      "releaseType": "draft"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
